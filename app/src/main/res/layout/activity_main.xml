<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1012">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLYWRITE"
                android:textColor="#8F949C"
                android:textSize="11sp"
                android:letterSpacing="0.32" />



            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▪册"
                android:textColor="#4D525A"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:padding="6dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▪字"
                android:textColor="#41464D"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tglTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▪时间"
                android:textColor="#41464D"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:padding="6dp" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 字"
                android:textColor="#6D727A"
                android:textSize="10sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1B1E23" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

             <com.greed.onlywrite.StoneEditText
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="top|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="42dp"
                android:textColor="#E9E6E1"
                android:textColorHint="#3F444B"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.0"
                android:lineSpacingExtra="6dp"
                android:inputType="textMultiLine|textCapSentences"
                android:importantForAutofill="no"
                android:scrollbars="none"
                android:hint="写吧。写下第一个字，它就留在石头上了。" />

            <TextView
                android:id="@+id/btnStrike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="划掉"
                android:textColor="#8A6A6A"
                android:textSize="11sp"
                android:letterSpacing="0.18"
                android:padding="6dp"
                android:background="#CC0F1012"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1B1E23" />

        <LinearLayout
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/btnRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▪拾音"
                android:textColor="#4D525A"
                android:textSize="11sp"
                android:letterSpacing="0.28"
                android:padding="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1B1E23" />

        <ScrollView
            android:id="@+id/statusWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="120dp"
            android:background="#141619"
            android:visibility="gone"
            android:scrollbars="none">

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:textColor="#6B7078"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:text="" />
        </ScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/sbWrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/sbScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <LinearLayout
            android:id="@+id/sbPanel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#131518">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLYWRITE"
                android:textColor="#8F949C"
                android:textSize="11sp"
                android:letterSpacing="0.32"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1B1E23" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tabWrite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="刻录"
                    android:textColor="#E9E6E1"
                    android:textSize="13sp"
                    android:letterSpacing="0.24"
                    android:paddingEnd="20dp" />

                <TextView
                    android:id="@+id/tabArch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="归档"
                    android:textColor="#5F646C"
                    android:textSize="13sp"
                    android:letterSpacing="0.24"
                    android:paddingEnd="20dp" />

                <TextView
                    android:id="@+id/tabRec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拾音"
                    android:textColor="#5F646C"
                    android:textSize="13sp"
                    android:letterSpacing="0.24" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1B1E23" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sbList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="16dp" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1B1E23" />

            <TextView
                android:id="@+id/sbExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="所有归档导出为文件"
                android:textColor="#8A8271"
                android:textSize="12sp"
                android:letterSpacing="0.2"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="18dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
